# Gmail SMTP Configuration for Password Recovery Emails
# Copy this file to .env and fill in your Gmail credentials

# Your Gmail address
GMAIL_ADDRESS=your-email@gmail.com

# Gmail App Password (NOT your regular password!)
# To get an App Password:
# 1. Go to https://myaccount.google.com/apppasswords
# 2. Select "Mail" and "Windows Computer" (or your platform)
# 3. Google will generate a 16-character password
# 4. Paste that password here (spaces will be removed automatically)
GMAIL_PASSWORD=your-16-char-app-password

# Base URL used inside password reset emails.
# For local testing on the same computer, this is usually:
# APP_BASE_URL=http://127.0.0.1:5000
# If opening the email from another device, use an address that device can reach.
APP_BASE_URL=http://127.0.0.1:5000
